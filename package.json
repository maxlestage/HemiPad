{
  "name": "hemipad",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de HemiPad (Rust, Yew, WebAssembly), servi par Express.",
  "license": "UNLICENSED",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "test": "npm run test --workspace=web",
    "start": "node server/index.mjs",
    "verify:site": "node web/tools/verify-site.mjs",
    "assets": "node web/tools/generate-assets.mjs",
    "heroku-postbuild": "sh web/tools/heroku-construire.sh"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
